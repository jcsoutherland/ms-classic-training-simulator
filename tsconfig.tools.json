{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tools", "src/sim", "src/data", "src/character"],
  "exclude": ["src/data/loadGameData.ts", "src/sim/rankings.worker.ts", "src/sim/route.worker.ts", "src/character/storage.ts"]
}
